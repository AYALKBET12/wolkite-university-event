NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/wolkite_university_events
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CLIENT_URL=http://localhost:5173

# Set only when intentionally reseeding; this deletes user and organization data.
ALLOW_DESTRUCTIVE_SEED=false
SEED_SUPERADMIN_EMAIL=admin@wolkiteuniversity.edu.et
SEED_SUPERADMIN_PASSWORD=
